# Spikerz QA Tool - Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database
DB_PATH=./data/spikerz_qa.db

# Health Check Schedule (cron expression - default: daily at 8am)
HEALTH_CHECK_CRON=0 8 * * *

# Credential References (do NOT store actual passwords here)
# Use a secrets manager in production. These are reference IDs only.
CREDENTIAL_VAULT=local

# Platform API Keys (for real health checks - optional for mock mode)
# LINKEDIN_API_KEY=
# FACEBOOK_API_KEY=
# INSTAGRAM_API_KEY=
# TIKTOK_API_KEY=
# X_API_KEY=

# Alert Settings (optional)
# ALERT_EMAIL=qa-team@spikerz.com
# SLACK_WEBHOOK_URL=

# Mode: 'mock' for simulated checks, 'live' for real API checks
CHECK_MODE=mock
